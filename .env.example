# PostgreSQL async URL untuk aplikasi FastAPI
DATABASE_URL=postgresql+asyncpg://postgres:GANTI_PASSWORD@localhost:5432/smart_kos_db

# PostgreSQL DSN untuk script migrasi dan import data
DATABASE_DSN=host=localhost port=5432 dbname=smart_kos_db user=postgres password=GANTI_PASSWORD

# Konfigurasi server
API_HOST=0.0.0.0
API_PORT=8000
SMARTKOS_DEBUG=true

# Gemini Developer API
GEMINI_API_KEY=GANTI_DENGAN_API_KEY_GEMINI
GEMINI_MODEL_NAME=gemini-3.5-flash
